{{!
    @template mod_saylorcode/activity_shell

    The coding workspace: a file bar, an editor with standard input and the
    student actions, and a results pane.

    The pane headings are screen reader only. They exist so that a screen
    reader user can move between the editor and the results directly, but they
    are not drawn, because a visible "Instructions" or "Results" heading inside
    a Book chapter reads as part of the chapter rather than part of the tool.
    The instructions are the surrounding page, or the activity introduction,
    which is rendered separately.

    Results sections start hidden and are revealed by the workspace module when
    they have something to show, so an untouched workspace does not display a
    row of empty headings.

    Classes required for JS:
    * saylorcode-shell
    * saylorcode-editor

    Data attributes required for JS:
    * data-region="saylorcode-shell"
    * data-cmid
    * data-action

    Context variables required for this template:
    * cmid int The course module id.
    * instanceid int The activity instance id.
    * activitymode string One of guided, challenge, project or playground.
    * stableid string The referenced exercise stable id, may be empty.
    * profileid string The runtime profile id.
    * runtimename string Student facing language name.
    * entryfilename string The file the student edits.
    * initialcode string The student's current code, rendered server side.
    * hastests bool Whether the activity defines any test cases.
    * canattempt bool Whether the viewer may edit and run code.
    * allowhints bool Whether hints are offered.
    * allowdownload bool Whether the download control is offered.
    * nopermission string|null Message shown when the viewer may not attempt.

    Example context (json):
    {
        "cmid": 42,
        "instanceid": 7,
        "activitymode": "challenge",
        "stableid": "CS101-U05-E03",
        "profileid": "java17-console",
        "runtimename": "Java 17 (console)",
        "entryfilename": "Main.java",
        "initialcode": "public class Main {}",
        "hastests": true,
        "canattempt": true,
        "allowhints": true,
        "allowdownload": true,
        "nopermission": null
    }
}}
{{#nopermission}}
    <div class="alert alert-info" role="status">{{.}}</div>
{{/nopermission}}

{{#canattempt}}
<div class="saylorcode-shell"
     data-region="saylorcode-shell"
     data-cmid="{{cmid}}"
     data-instanceid="{{instanceid}}"
     data-mode="{{activitymode}}"
     data-entryfilename="{{entryfilename}}"
     data-profileid="{{profileid}}">

    <div class="saylorcode-filebar">
        <span class="saylorcode-filename">{{entryfilename}}</span>
        <span class="saylorcode-runtime">{{runtimename}}</span>
    </div>

    <div class="saylorcode-panes">

        <section class="saylorcode-pane saylorcode-pane-editor"
                 aria-labelledby="saylorcode-editor-heading-{{cmid}}">
            <h3 id="saylorcode-editor-heading-{{cmid}}" class="sr-only">
                {{#str}}editorheading, mod_saylorcode{{/str}}
            </h3>

            <label for="saylorcode-editor-{{cmid}}" class="sr-only">
                {{#str}}editorlabel, mod_saylorcode, {{entryfilename}}{{/str}}
            </label>
            <textarea id="saylorcode-editor-{{cmid}}"
                      class="saylorcode-editor"
                      data-region="editor"
                      rows="18"
                      spellcheck="false"
                      autocomplete="off"
                      autocapitalize="off"
                      autocorrect="off">{{initialcode}}</textarea>

            <div class="saylorcode-stdin-wrap">
                <label for="saylorcode-stdin-{{cmid}}">{{#str}}stdin, mod_saylorcode{{/str}}</label>
                <textarea id="saylorcode-stdin-{{cmid}}"
                          class="saylorcode-stdin"
                          data-region="stdin"
                          rows="2"
                          spellcheck="false"
                          autocomplete="off"></textarea>
            </div>

            <div class="saylorcode-actions" role="group"
                 aria-label="{{#str}}actionsheading, mod_saylorcode{{/str}}">
                <button type="button" class="btn btn-primary btn-sm" data-action="run">
                    {{#str}}run, mod_saylorcode{{/str}}
                </button>
                {{#hastests}}
                <button type="button" class="btn btn-secondary btn-sm" data-action="check">
                    {{#str}}check, mod_saylorcode{{/str}}
                </button>
                <button type="button" class="btn btn-secondary btn-sm" data-action="submit">
                    {{#str}}submit, mod_saylorcode{{/str}}
                </button>
                {{/hastests}}
                <button type="button" class="btn btn-link btn-sm" data-action="reset">
                    {{#str}}reset, mod_saylorcode{{/str}}
                </button>
                {{#allowdownload}}
                <button type="button" class="btn btn-link btn-sm" data-action="download">
                    {{#str}}download{{/str}}
                </button>
                {{/allowdownload}}

                {{! Save and execution state is announced, not only shown. }}
                <p class="saylorcode-status" data-region="status" role="status" aria-live="polite"></p>
            </div>
        </section>

        <section class="saylorcode-pane saylorcode-pane-results"
                 aria-labelledby="saylorcode-results-heading-{{cmid}}">
            <h3 id="saylorcode-results-heading-{{cmid}}" class="sr-only">
                {{#str}}resultsheading, mod_saylorcode{{/str}}
            </h3>

            <div class="saylorcode-results-section">
                <h4 class="saylorcode-results-heading">{{#str}}console, mod_saylorcode{{/str}}</h4>
                <pre class="saylorcode-console"
                     data-region="console"
                     data-placeholder="{{#str}}consoleempty, mod_saylorcode{{/str}}"
                     tabindex="0"></pre>
            </div>

            <div class="saylorcode-results-section" data-region="tests-section" hidden>
                <h4 class="saylorcode-results-heading">{{#str}}tests, mod_saylorcode{{/str}}</h4>
                <div data-region="tests"></div>
            </div>

            <div class="saylorcode-results-section" data-region="feedback-section" hidden>
                <h4 class="saylorcode-results-heading">{{#str}}feedback, mod_saylorcode{{/str}}</h4>
                <div data-region="feedback"></div>
            </div>
        </section>

    </div>
</div>
{{/canattempt}}
{{#js}}
require(['mod_saylorcode/workspace'], function(Workspace) {
    Workspace.init({{cmid}});
});
{{/js}}
